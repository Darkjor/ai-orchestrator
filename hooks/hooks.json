{
  "description": "ai-orch: inject the arrival brief at session start, and remind the agent once per session to record the work before it ends.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session_start.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "Reading .ai/ context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/stop_nudge.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
